PORT=5000
MONGODB_URL=mongodb://127.0.0.1:27017/mernStackAssignment
CLIENT_URL=http://localhost:5173

# JWT (generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing cost (optional, default 12)
BCRYPT_SALT_ROUNDS=12

# Public URL of this API (used to build OAuth callback URLs)
SERVER_URL=http://localhost:5000

# Social login (optional: leave empty to disable a provider)
# Google:   https://console.cloud.google.com/apis/credentials
#           Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps  (Facebook Login product)
#           Valid OAuth redirect URI: http://localhost:5000/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
